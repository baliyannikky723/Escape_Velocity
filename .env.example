# ==============================================================================
# IncidentMind - Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=incidentmind
POSTGRES_USER=incidentmind
POSTGRES_PASSWORD=incidentmind
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Spring Boot Datasource Overrides (Used in Docker Compose & Production)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/incidentmind
SPRING_DATASOURCE_USERNAME=incidentmind
SPRING_DATASOURCE_PASSWORD=incidentmind

# Server Configuration
SERVER_PORT=8080

# Demo Data Initializer (set to true for local seed data)
INCIDENTMIND_DEMO_DATA_ENABLED=false

# Tool Gateway & Failure Injection Configuration
FAILURE_INJECTION_ENABLED=false

# Recovery & Resilience Configuration
RECOVERY_ENABLED=true
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_INITIAL_BACKOFF_MS=200
RECOVERY_MAX_BACKOFF_MS=3000

# GitHub REST API Configuration (Token is optional for public repos)
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_CONNECT_TIMEOUT_MS=2000
GITHUB_READ_TIMEOUT_MS=5000

# FastAPI AI Intelligence Service Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_ENABLED=true
AI_SERVICE_TIMEOUT_SECONDS=5

# LLM Provider Configuration (mock, openai, gemini, ollama, anthropic)
# Default: mock (Safe offline testing without API key or external dependency)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=2

# Human-In-The-Loop Thresholds
MAX_CONSECUTIVE_CRITIC_REJECTIONS=3
MAX_PLANNING_FAILURES=2
